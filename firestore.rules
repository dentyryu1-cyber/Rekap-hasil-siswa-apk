rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Blueprints (create + update safe, no resource/diff inside)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'darkMode',
          'buttonStyle',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'darkMode',
          'buttonStyle',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 200
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.darkMode is bool
        && data.buttonStyle is string
        && data.buttonStyle.size() <= 20
        && data.buttonStyle in ['wood', 'tactile', 'flat', 'glass']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAbcWorkspace(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'examTitle',
          'questionCount',
          'answerKey',
          'rows',
          'seq',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'examTitle',
          'questionCount',
          'answerKey',
          'rows',
          'seq',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.examTitle is string
        && data.examTitle.size() <= 200
        && data.questionCount is int
        && data.questionCount >= 1
        && data.questionCount <= 200
        && data.answerKey is list
        && data.answerKey.size() <= 200
        && (data.answerKey.size() == 0 || data.answerKey[0] is string)
        && data.rows is list
        && data.rows.size() <= 500
        && (data.rows.size() == 0 || data.rows[0] is map)
        && data.seq is int
        && data.seq >= 0
        && data.seq <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUraianWorkspace(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'subMode',
          'examTitle',
          'itemCount',
          'scaleMin',
          'defaultMaxScore',
          'itemMaxScores',
          'rows',
          'seq',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'subMode',
          'examTitle',
          'itemCount',
          'scaleMin',
          'defaultMaxScore',
          'itemMaxScores',
          'rows',
          'seq',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.subMode is string
        && data.subMode.size() <= 20
        && data.subMode in ['uraian', 'angket-4', 'angket-5', 'custom']
        && data.examTitle is string
        && data.examTitle.size() <= 200
        && data.itemCount is int
        && data.itemCount >= 1
        && data.itemCount <= 100
        && (data.scaleMin is int || data.scaleMin is float)
        && data.scaleMin >= -100
        && data.scaleMin <= 1000
        && (data.defaultMaxScore is int || data.defaultMaxScore is float)
        && data.defaultMaxScore > data.scaleMin
        && data.defaultMaxScore <= 10000
        && data.itemMaxScores is list
        && data.itemMaxScores.size() <= 100
        && (data.itemMaxScores.size() == 0 || data.itemMaxScores[0] is int || data.itemMaxScores[0] is float)
        && data.rows is list
        && data.rows.size() <= 500
        && (data.rows.size() == 0 || data.rows[0] is map)
        && data.seq is int
        && data.seq >= 0
        && data.seq <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User profile & UI preferences (PII owner-only)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedEmail()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedEmail()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['darkMode', 'buttonStyle', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'darkMode', 'buttonStyle', 'updatedAt'])
        );
      allow delete: if isVerifiedEmail() && isOwner(userId) && isValidId(userId);

      // ABC Workspace subcollection
      match /abc_workspaces/{workspaceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId);
        allow list: if false;
        allow create: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidAbcWorkspace(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidAbcWorkspace(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'examTitle',
            'questionCount',
            'answerKey',
            'rows',
            'seq',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // Angket / Uraian Workspace subcollection
      match /uraian_workspaces/{workspaceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId);
        allow list: if false;
        allow create: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidUraianWorkspace(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidUraianWorkspace(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'subMode',
            'examTitle',
            'itemCount',
            'scaleMin',
            'defaultMaxScore',
            'itemMaxScores',
            'rows',
            'seq',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedEmail()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
